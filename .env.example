# Copie para .env e altere as credenciais. Somente desenvolvimento local.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_DB=my_database

# Perfis opcionais: mysql / mongodb
MYSQL_ROOT_PASSWORD=troque-esta-senha-root-local
MYSQL_DATABASE=my_database
MYSQL_USER=backup_dev
MYSQL_PASSWORD=troque-esta-senha-mysql-local
MONGO_USER=admin
MONGO_PASSWORD=troque-esta-senha-mongo-local

# CLI (opcional). A CLI não lê o .env: exporte no shell quando precisar.
# Use só uma fonte de senha. Para agendadores, prefira o arquivo (permissão 600):
#   install -m 600 /dev/null ~/.config/dbu/pg.pass
# DBU_PG_PASSWORD_FILE=
# DBU_PG_PASSWORD=
# MySQL (--engine mysql) usa variáveis próprias, para não reaproveitar a senha do PostgreSQL:
# DBU_MYSQL_PASSWORD_FILE=
# DBU_MYSQL_PASSWORD=
# MongoDB (--engine mongodb) também usa variáveis próprias:
# DBU_MONGO_PASSWORD_FILE=
# DBU_MONGO_PASSWORD=
# DBU_DATA_DIR=
